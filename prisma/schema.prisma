generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                     @id @default(uuid()) @db.Uuid
  email                   String                     @unique
  passwordHash            String                     @map("password_hash")
  fullName                String                     @map("full_name")
  phone                   String?
  avatarUrl               String?                    @map("avatar_url")
  preferredLanguage       String                     @default("vi") @map("preferred_language") @db.VarChar(5)
  isActive                Boolean                    @default(true) @map("is_active")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  cancelledAppointments   Appointment[]              @relation("CancelledByUser")
  createdAppointments     Appointment[]              @relation("CreatedByUser")
  chatSessions            ChatSession[]
  documentVersionChanges  DocumentVersion[]
  createdForms            Form[]
  authoredDocuments       InternalDocument[]
  inventoryTransactions   InventoryTransaction[]
  closedKioskSessions     KioskSession[]             @relation("KioskClosedByUser")
  createdKioskSessions    KioskSession[]             @relation("KioskCreatedByUser")
  passwordResetTokens     PasswordResetToken[]
  uploadedFiles           PatientFile[]
  requestedOverrides      ProviderScheduleOverride[] @relation("RequestedByUser")
  reviewedOverrides       ProviderScheduleOverride[] @relation("ReviewedByUser")
  provider                Provider?
  refreshTokens           RefreshToken[]
  grantedOverrides         UserPermissionOverride[]   @relation("GrantedByUser")
  revokedOverrides         UserPermissionOverride[]   @relation("RevokedByUser")
  userPermissionOverrides  UserPermissionOverride[]
  userRoles                UserRole[]
  createdPatientProcedures PatientProcedure[]         @relation("PatientProcedureCreator")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  code            String?          @unique @db.VarChar(32)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id                      String                   @id @default(uuid()) @db.Uuid
  resource                String
  action                  String
  scope                   String?
  description             String?
  ragDocumentPermissions  RagDocumentPermission[]
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  permissionId  String     @map("permission_id") @db.Uuid
  grantType     String     @map("grant_type")
  reason        String?
  grantedBy     String     @map("granted_by") @db.Uuid
  expiresAt     DateTime?  @map("expires_at")
  isActive      Boolean    @default(true) @map("is_active")
  revokedBy     String?    @map("revoked_by") @db.Uuid
  revokedAt     DateTime?  @map("revoked_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  grantedByUser User       @relation("GrantedByUser", fields: [grantedBy], references: [id])
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  revokedByUser User?      @relation("RevokedByUser", fields: [revokedBy], references: [id])
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId], map: "user_permission_overrides_active_unique", where: raw("(is_active = true)"))
  @@map("user_permission_overrides")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  eventCode      String   @map("event_code")
  eventVersion   Int      @default(1) @map("event_version") @db.SmallInt
  category       String
  severity       String
  outcome        String
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  actorRoleCodes String[] @default([]) @map("actor_role_codes")
  sessionId      String?  @map("session_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  resource       String?
  resourceId     String?  @map("resource_id") @db.Uuid
  parentResource String?  @map("parent_resource")
  parentId       String?  @map("parent_id") @db.Uuid
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  source         String
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_audit_logs_created_at_brin", type: Brin)
  @@index([eventCode, createdAt(sort: Desc)], map: "idx_audit_logs_event_code_time")
  @@index([metadata(ops: JsonbPathOps)], map: "idx_audit_logs_metadata_gin", type: Gin)
  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_logs_actor_time", where: raw("(actor_id IS NOT NULL)"))
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_phi_time", where: raw("(category = 'phi'::text)"))
  @@index([resource, resourceId, createdAt(sort: Desc)], map: "idx_audit_logs_resource_time", where: raw("(resource_id IS NOT NULL)"))
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Provider {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @unique @map("user_id") @db.Uuid
  specialty         String?
  licenseNumber     String?                    @map("license_number")
  isActive          Boolean                    @default(true) @map("is_active")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  appointments        Appointment[]
  clinicalNotes       ClinicalNote[]
  scheduleOverrides   ProviderScheduleOverride[]
  schedules           ProviderSchedule[]
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  treatmentPlans      TreatmentPlan[]
  plannedProcedures   PatientProcedure[]         @relation("PlannedProvider")
  performedProcedures PatientProcedure[]         @relation("PerformedByProvider")

  @@map("providers")
}

model ProviderSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_schedules")
}

model ProviderScheduleOverride {
  id           String    @id @default(uuid()) @db.Uuid
  providerId   String    @map("provider_id") @db.Uuid
  requestedBy  String    @map("requested_by") @db.Uuid
  specificDate DateTime  @map("specific_date") @db.Date
  overrideType String    @map("override_type")
  startTime    String?   @map("start_time")
  endTime      String?   @map("end_time")
  reason       String?
  status       String    @default("pending")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note")
  provider     Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requester    User      @relation("RequestedByUser", fields: [requestedBy], references: [id])
  reviewer     User?     @relation("ReviewedByUser", fields: [reviewedBy], references: [id])

  @@unique([providerId, specificDate], map: "overrides_day_off_unique", where: raw("(status = 'approved' AND override_type = 'day_off')"))
  @@map("provider_schedule_overrides")
}

model AppointmentType {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  durationMinutes Int           @map("duration_minutes")
  color           String?
  isActive        Boolean       @default(true) @map("is_active")
  appointments    Appointment[]

  @@map("appointment_types")
}

model Procedure {
  id                    String                 @id @default(uuid()) @db.Uuid
  adaCode               String                 @unique @map("ada_code")
  name                  String
  category              String?
  durationMinutes       Int?                   @map("duration_minutes")
  defaultFee            Decimal?               @map("default_fee") @db.Decimal(10, 2)
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  patientProcedures PatientProcedure[]

  @@map("procedures")
}

model TreatmentPlan {
  id                 String             @id @default(uuid()) @db.Uuid
  patientId          String             @map("patient_id") @db.Uuid
  providerId         String             @map("provider_id") @db.Uuid
  name               String
  status             String             @default("draft")
  startDate          DateTime?          @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  notes              String?
  consentSignedAt    DateTime?          @map("consent_signed_at")
  consentSignedBy    String?            @map("consent_signed_by")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  patient            Patient            @relation(fields: [patientId], references: [id])
  provider           Provider           @relation(fields: [providerId], references: [id])
  patientProcedures  PatientProcedure[]

  @@index([patientId, status])
  @@map("treatment_plans")
}

model Appointment {
  id                 String             @id @default(uuid()) @db.Uuid
  patientId          String             @map("patient_id") @db.Uuid
  providerId         String             @map("provider_id") @db.Uuid
  typeId             String             @map("type_id") @db.Uuid
  createdBy          String             @map("created_by") @db.Uuid
  startTime          DateTime           @map("start_time")
  endTime            DateTime           @map("end_time")
  status             String             @default("scheduled")
  notes              String?
  chiefComplaint     String?            @map("chief_complaint")
  cancelledBy        String?            @map("cancelled_by") @db.Uuid
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  checkedInAt        DateTime?          @map("checked_in_at")
  startedAt          DateTime?          @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  cancelledByUser    User?              @relation("CancelledByUser", fields: [cancelledBy], references: [id])
  createdByUser      User               @relation("CreatedByUser", fields: [createdBy], references: [id])
  patient            Patient            @relation(fields: [patientId], references: [id])
  provider           Provider           @relation(fields: [providerId], references: [id])
  appointmentType    AppointmentType    @relation(fields: [typeId], references: [id])
  clinicalNote       ClinicalNote?
  formSubmissions    FormSubmission[]
  kioskSessions      KioskSession[]
  patientProcedures  PatientProcedure[]

  @@index([providerId, startTime])
  @@index([patientId])
  @@map("appointments")
}

model PatientProcedure {
  id                    String         @id @default(uuid()) @db.Uuid
  patientId             String         @map("patient_id") @db.Uuid
  procedureId           String         @map("procedure_id") @db.Uuid
  treatmentPlanId       String?        @map("treatment_plan_id") @db.Uuid
  appointmentId         String?        @map("appointment_id") @db.Uuid
  plannedProviderId     String?        @map("planned_provider_id") @db.Uuid
  performedByProviderId String?        @map("performed_by_provider_id") @db.Uuid
  toothNumber           String?        @map("tooth_number") @db.VarChar(8)
  surface               String?        @db.VarChar(8)
  diagnosis             String?
  clinicalNotes         String?        @map("clinical_notes")
  estimatedFee          Decimal?       @map("estimated_fee") @db.Decimal(10, 2)
  actualFee             Decimal?       @map("actual_fee") @db.Decimal(10, 2)
  feeFinalizedAt        DateTime?      @map("fee_finalized_at")
  status                String         @default("planned")
  plannedAt             DateTime?      @map("planned_at")
  scheduledAt           DateTime?      @map("scheduled_at")
  startedAt             DateTime?      @map("started_at")
  completedAt           DateTime?      @map("completed_at")
  cancelledAt           DateTime?      @map("cancelled_at")
  cancellationReason    String?        @map("cancellation_reason")
  sequenceInPlan        Int?           @map("sequence_in_plan")
  createdBy             String         @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")
  patient               Patient        @relation(fields: [patientId], references: [id])
  procedure             Procedure      @relation(fields: [procedureId], references: [id])
  treatmentPlan         TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  appointment           Appointment?   @relation(fields: [appointmentId], references: [id])
  plannedProvider       Provider?      @relation("PlannedProvider", fields: [plannedProviderId], references: [id])
  performedBy           Provider?      @relation("PerformedByProvider", fields: [performedByProviderId], references: [id])
  creator               User           @relation("PatientProcedureCreator", fields: [createdBy], references: [id])

  @@index([patientId, status, deletedAt])
  @@index([treatmentPlanId])
  @@index([appointmentId])
  @@index([status, scheduledAt])
  @@map("patient_procedures")
}

model ClinicalNote {
  id            String      @id @default(uuid()) @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  providerId    String      @map("provider_id") @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
  provider      Provider    @relation(fields: [providerId], references: [id])

  @@index([patientId, deletedAt])
  @@map("clinical_notes")
}

model Patient {
  id                    String           @id @default(uuid()) @db.Uuid
  firstName             String           @map("first_name")
  lastName              String           @map("last_name")
  dateOfBirth           DateTime?        @map("date_of_birth") @db.Date
  gender                String?
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?          @map("emergency_contact_name")
  emergencyContactPhone String?          @map("emergency_contact_phone")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")
  appointments       Appointment[]
  clinicalNotes      ClinicalNote[]
  formSubmissions    FormSubmission[]
  kioskSessions      KioskSession[]
  files              PatientFile[]
  treatmentPlans     TreatmentPlan[]
  patientProcedures  PatientProcedure[]

  @@index([deletedAt])
  @@map("patients")
}

model PatientFile {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  fileName    String    @map("file_name")
  fileType    String    @map("file_type")
  fileUrl     String    @map("file_url")
  fileSize    BigInt    @map("file_size")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  category    String    @default("other")
  description String?
  title       String?
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploader    User      @relation(fields: [uploadedBy], references: [id])

  @@map("patient_files")
}

model Form {
  id                String             @id @default(uuid()) @db.Uuid
  createdBy         String             @map("created_by") @db.Uuid
  title             String
  description       String?
  schema            Json
  isPublished       Boolean            @default(false) @map("is_published")
  isKioskEnabled    Boolean            @default(false) @map("is_kiosk_enabled")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")
  submissions       FormSubmission[]
  creator           User               @relation(fields: [createdBy], references: [id])
  kioskSessionForms KioskSessionForm[]

  @@map("forms")
}

model FormSubmission {
  id             String        @id @default(uuid()) @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  formId         String        @map("form_id") @db.Uuid
  appointmentId  String?       @map("appointment_id") @db.Uuid
  kioskSessionId String?       @map("kiosk_session_id") @db.Uuid
  data           Json
  submittedAt    DateTime      @default(now()) @map("submitted_at")
  deletedAt      DateTime?     @map("deleted_at")
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  form           Form          @relation(fields: [formId], references: [id])
  kioskSession   KioskSession? @relation(fields: [kioskSessionId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])

  @@map("form_submissions")
}

model KioskSession {
  id                    String             @id @default(uuid()) @db.Uuid
  patientId             String             @map("patient_id") @db.Uuid
  appointmentId         String?            @map("appointment_id") @db.Uuid
  createdBy             String             @map("created_by") @db.Uuid
  tokenHash             String             @unique @map("token_hash")
  expiresInMinutes      Int                @default(30) @map("expires_in_minutes")
  expiresAt             DateTime           @map("expires_at")
  status                String             @default("active")
  deviceFingerprintHash String?            @map("device_fingerprint_hash")
  initialIp             String?            @map("initial_ip")
  closedBy              String?            @map("closed_by") @db.Uuid
  closedReason          String?            @map("closed_reason")
  createdAt             DateTime           @default(now()) @map("created_at")
  closedAt              DateTime?          @map("closed_at")
  formSubmissions       FormSubmission[]
  sessionForms          KioskSessionForm[]
  appointment           Appointment?       @relation(fields: [appointmentId], references: [id])
  closer                User?              @relation("KioskClosedByUser", fields: [closedBy], references: [id])
  creator               User               @relation("KioskCreatedByUser", fields: [createdBy], references: [id])
  patient               Patient            @relation(fields: [patientId], references: [id])

  @@index([tokenHash])
  @@map("kiosk_sessions")
}

model KioskSessionForm {
  id          String       @id @default(uuid()) @db.Uuid
  sessionId   String       @map("session_id") @db.Uuid
  formId      String       @map("form_id") @db.Uuid
  status      String       @default("pending")
  completedAt DateTime?    @map("completed_at")
  form        Form         @relation(fields: [formId], references: [id])
  session     KioskSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("kiosk_session_forms")
}

model InternalDocument {
  id             String            @id @default(uuid()) @db.Uuid
  createdBy      String            @map("created_by") @db.Uuid
  title          String
  content        String?
  category       String?
  currentVersion Int               @default(1) @map("current_version")
  isPublished    Boolean           @default(false) @map("is_published")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")
  versions       DocumentVersion[]
  creator        User              @relation(fields: [createdBy], references: [id])

  @@map("internal_documents")
}

model DocumentVersion {
  id            String           @id @default(uuid()) @db.Uuid
  documentId    String           @map("document_id") @db.Uuid
  changedBy     String           @map("changed_by") @db.Uuid
  versionNumber Int              @map("version_number")
  content       String?
  createdAt     DateTime         @default(now()) @map("created_at")
  changer       User             @relation(fields: [changedBy], references: [id])
  document      InternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model InventoryItem {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String
  sku          String                 @unique
  category     String?
  quantity     Int                    @default(0)
  unit         String?
  minQuantity  Int                    @default(0) @map("min_quantity")
  costPerUnit  Decimal?               @map("cost_per_unit") @db.Decimal(10, 2)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  itemId         String        @map("item_id") @db.Uuid
  quantityChange Int           @map("quantity_change")
  type           String
  referenceId    String?       @map("reference_id")
  performedBy    String        @map("performed_by") @db.Uuid
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  item           InventoryItem @relation(fields: [itemId], references: [id])
  performer      User          @relation(fields: [performedBy], references: [id])

  @@map("inventory_transactions")
}

model EmailLog {
  id             String    @id @default(uuid()) @db.Uuid
  resendId       String?   @unique @map("resend_id")
  fromAddress    String    @map("from_address")
  recipientEmail String    @map("recipient_email")
  subject        String
  status         String    @default("pending")
  variables      Json?
  errorMessage   String?   @map("error_message")
  attachments    Json?
  tags           Json?
  batchId        String?   @map("batch_id")
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  sentAt         DateTime? @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  bouncedAt      DateTime? @map("bounced_at")
  complainedAt   DateTime? @map("complained_at")
  webhookEvents  Json?     @map("webhook_events")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  templateName   String    @map("template_name")

  @@index([resendId])
  @@index([recipientEmail])
  @@index([status])
  @@index([entityType, entityId])
  @@index([batchId])
  @@map("email_logs")
}

model RagDocument {
  id                  String                  @id @default(uuid()) @db.Uuid
  sourceType          String                  @map("source_type")
  sourceId            String                  @map("source_id") @db.Uuid
  patientId           String?                 @map("patient_id") @db.Uuid
  filename            String?
  contentType         String?                 @map("content_type")
  totalParentChunks   Int                     @default(0) @map("total_parent_chunks")
  totalChildChunks    Int                     @default(0) @map("total_child_chunks")
  status              String                  @default("pending")
  errorMessage        String?                 @map("error_message")
  contentHash         String?                 @map("content_hash")
  ingestionTimeMs     Float?                  @map("ingestion_time_ms")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  childChunks         ChildChunk[]
  parentChunks        ParentChunk[]
  documentPermissions RagDocumentPermission[]

  @@unique([sourceType, sourceId], map: "rag_documents_source_unique", where: raw("(status <> 'failed'::text)"))
  @@index([sourceType, sourceId])
  @@map("rag_documents")
}

model RagDocumentPermission {
  id            String      @id @default(uuid()) @db.Uuid
  ragDocumentId String      @map("rag_document_id") @db.Uuid
  permissionId  String      @map("permission_id") @db.Uuid
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  ragDocument   RagDocument @relation(fields: [ragDocumentId], references: [id], onDelete: Cascade)

  @@unique([ragDocumentId, permissionId])
  @@index([ragDocumentId])
  @@map("rag_document_permissions")
}

model ParentChunk {
  id            String       @id @default(uuid()) @db.Uuid
  ragDocumentId String       @map("rag_document_id") @db.Uuid
  heading       String?
  chunkIndex    Int          @map("chunk_index")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  childChunks   ChildChunk[]
  ragDocument   RagDocument  @relation(fields: [ragDocumentId], references: [id], onDelete: Cascade)

  @@map("parent_chunks")
}

model ChildChunk {
  id            String                   @id @default(uuid()) @db.Uuid
  parentChunkId String                   @map("parent_chunk_id") @db.Uuid
  ragDocumentId String                   @map("rag_document_id") @db.Uuid
  content       String
  embedding     Unsupported("vector")?
  searchVector  Unsupported("tsvector")? @map("search_vector")
  chunkIndex    Int                      @map("chunk_index")
  metadata      Json?
  createdAt     DateTime                 @default(now()) @map("created_at")
  parentChunk   ParentChunk              @relation(fields: [parentChunkId], references: [id], onDelete: Cascade)
  ragDocument   RagDocument              @relation(fields: [ragDocumentId], references: [id], onDelete: Cascade)

  @@index([ragDocumentId])
  @@map("child_chunks")
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  role      String
  content   String
  citations Json?
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

<!-- Welcome email content -->
<mj-section padding="0 24px" css-class="panel-wrap">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      {{welcomeHeading}}
    </mj-text>
    <mj-text color="#52525b" padding="0 0 16px">
      {{greeting}}
    </mj-text>
    <mj-text padding="0">
      {{#if temporaryPassword}}
      <p style="margin:0 0 12px;color:#52525b;">{{credentialsIntro}}</p>
      <div
        style="
          margin:0 0 12px;
          padding:16px 20px;
          background-color:#f4f4f5;
          border:1px solid #e4e4e7;
          border-radius:12px;
          font-size:14px;
          color:#27272a;
        "
      >
        <div style="margin-bottom:6px;"><strong style="color:#71717a;">{{emailLabel}}</strong> {{email}}</div>
        <div><strong style="color:#71717a;">{{tempPasswordLabel}}</strong> <code style="background:#ffffff;padding:2px 8px;border-radius:6px;border:1px solid #e4e4e7;color:#6366f1;font-weight:600;">{{temporaryPassword}}</code></div>
      </div>
      <p style="margin:0;color:#71717a;font-size:13px;">{{passwordChangeNote}}</p>
      {{else}}
      <p style="margin:0;color:#52525b;">{{noPasswordIntro}}</p>
      {{/if}}
    </mj-text>
    <mj-button href="{{loginLink}}" padding="24px 0 0">
      {{loginButton}}
    </mj-button>
  </mj-column>
</mj-section>

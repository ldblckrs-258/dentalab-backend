<!-- Password reset email content -->
<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Đặt lại mật khẩu
    </mj-text>
    <mj-text color="#52525b" padding="0 0 12px">
      Xin chào {{userName}},
    </mj-text>
    <mj-text color="#52525b" padding="0 0 8px">
      Chúng tôi nhận được yêu cầu đặt lại mật khẩu của bạn. Nhấn nút bên dưới để đặt mật khẩu mới. Nếu bạn không thực hiện yêu cầu này, bạn có thể bỏ qua email này một cách an toàn.
    </mj-text>
    <mj-button href="{{resetLink}}" padding="20px 0">
      Đặt lại mật khẩu
    </mj-button>
    <mj-text font-size="12px" color="#71717a" padding="0">
      Liên kết này sẽ hết hạn sau {{expiresIn}}.
    </mj-text>
  </mj-column>
</mj-section>

<!-- Content section for password-reset -->
<mj-section background-color="#ffffff" padding="30px 20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold">Reset Your Password</mj-text>
    <mj-text>Hello {{userName}},</mj-text>
    <mj-text>
      We received a request to reset your password. Click the button below to set a new password:
    </mj-text>
    <mj-button href="{{resetLink}}">
      Reset Password
    </mj-button>
    <mj-text font-size="12px" color="#6b7280">
      This link will expire in {{expiresIn}}. If you didn't request a password reset, you can safely ignore this email.
    </mj-text>
  </mj-column>
</mj-section>

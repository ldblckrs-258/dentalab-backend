<!-- Password reset email content -->
<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      {{heading}}
    </mj-text>
    <mj-text color="#52525b" padding="0 0 12px">
      {{greeting}}
    </mj-text>
    <mj-text color="#52525b" padding="0 0 8px">
      {{intro}}
    </mj-text>
    <mj-button href="{{resetLink}}" padding="20px 0">
      {{buttonText}}
    </mj-button>
    <mj-text font-size="12px" color="#71717a" padding="0">
      {{expiryNote}}
    </mj-text>
  </mj-column>
</mj-section>

# ===========================================
# DentaLab Backend — Environment Variables
# ===========================================

# --- App ---
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001
APP_NAME=DentaLab API

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://psql:psql_secret@localhost:5480/psql?schema=public
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://admin:admin_secret@localhost:5680
RABBITMQ_PREFETCH_COUNT=10

# --- Storage (S3-Compatible: MinIO / Cloudflare R2) ---
S3_ENDPOINT=http://localhost:9020
S3_REGION=auto
S3_BUCKET=admin
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret
S3_MAX_FILE_SIZE=52428800
S3_PUBLIC_URL=http://localhost:9020
# Enable SSE-S3 (AES-256). Set true for prod (MinIO+KES or AWS S3). Leave false for dev.
S3_SSE_ENABLED=false

# --- JWT ---
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Admin Seed ---
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=Admin@123

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@dentalab.com
EMAIL_FROM_NAME=DentaLab
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
FRONTEND_URL=http://localhost:3001

# --- AI / RAG ---
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_TOKEN=change-me-min-16-chars
AI_CONFIG_ENCRYPTION_KEY=
LLM_ANSWER_TIMEOUT_MS=45000
LLM_REWRITE_TIMEOUT_MS=15000

# --- Public Booking ---
BOOKING_TICKET_SECRET=change-me-booking-ticket-secret
BOOKING_OTP_PEPPER=change-me-otp-pepper-secret

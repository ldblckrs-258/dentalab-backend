<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    {{#if isUser}}
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Lịch hẹn đã hoàn thành
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Xin chào {{providerName}},<br />
      Lịch hẹn với bệnh nhân {{patientName}} tại {{clinicName}} đã được hoàn thành.
    </mj-text>
    {{else}}
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Cảm ơn bạn đã đến khám!
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Xin chào {{patientName}},<br />
      Lịch hẹn của bạn tại {{clinicName}} đã hoàn thành. Cảm ơn bạn đã tin tưởng chúng tôi.
    </mj-text>
    {{/if}}
    <mj-section padding="0 0 20px">
      <mj-column
        background-color="#f4f4f5"
        border-radius="12px"
        padding="20px"
      >
        <mj-text padding="0 0 8px">
          <strong>Dịch vụ:</strong> {{serviceName}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Ngày khám:</strong> {{appointmentDate}}
        </mj-text>
        <mj-text padding="0">
          <strong>Mã đặt lịch:</strong> {{referenceId}}
        </mj-text>
      </mj-column>
    </mj-section>
    {{#unless isUser}}
    <mj-text font-size="12px" color="#71717a" padding="0">
      Nếu bạn có bất kỳ câu hỏi nào sau buổi khám, vui lòng gọi hotline {{hotline}}.
    </mj-text>
    {{/unless}}
  </mj-column>
</mj-section>

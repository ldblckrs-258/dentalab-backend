<!-- Password reset email content -->
<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Password Reset
    </mj-text>
    <mj-text color="#52525b" padding="0 0 12px">
      Hello {{userName}},
    </mj-text>
    <mj-text color="#52525b" padding="0 0 8px">
      We received a request to reset your password. Click the button below to set a new password. If you did not make this request, you can safely ignore this email.
    </mj-text>
    <mj-button href="{{resetLink}}" padding="20px 0">
      Reset Password
    </mj-button>
    <mj-text font-size="12px" color="#71717a" padding="0">
      This link will expire in {{expiresIn}}.
    </mj-text>
  </mj-column>
</mj-section>

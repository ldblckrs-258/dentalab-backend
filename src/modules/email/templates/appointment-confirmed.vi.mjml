<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Lịch hẹn đã được xác nhận
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Xin chào {{patientName}},<br />
      Lịch hẹn của bạn tại {{clinicName}} đã được xác nhận. Chúng tôi mong được gặp bạn.
    </mj-text>
    <mj-section padding="0 0 20px">
      <mj-column
        background-color="#f4f4f5"
        border-radius="12px"
        padding="20px"
      >
        <mj-text padding="0 0 8px">
          <strong>Dịch vụ:</strong> {{serviceName}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Ngày khám:</strong> {{appointmentDate}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Giờ khám:</strong> {{appointmentTime}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Bác sĩ:</strong> {{providerName}}
        </mj-text>
        <mj-text padding="0">
          <strong>Mã đặt lịch:</strong> {{referenceId}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-text font-size="12px" color="#71717a" padding="0">
      Vui lòng đến đúng giờ. Nếu cần thay đổi, hãy gọi hotline {{hotline}}.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    {{#if isUser}}
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Reminder: Appointment tomorrow
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Hello {{providerName}},<br />
      You have a patient appointment tomorrow at {{clinicName}}.
    </mj-text>
    {{else}}
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Reminder: Your appointment is tomorrow
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Hello {{patientName}},<br />
      This is a reminder about your appointment at {{clinicName}} tomorrow.
    </mj-text>
    {{/if}}
    <mj-section padding="0 0 20px">
      <mj-column
        background-color="#f4f4f5"
        border-radius="12px"
        padding="20px"
      >
        <mj-text padding="0 0 8px">
          <strong>Service:</strong> {{serviceName}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Date:</strong> {{appointmentDate}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Time:</strong> {{appointmentTime}}
        </mj-text>
        {{#unless isUser}}
        <mj-text padding="0 0 8px">
          <strong>Doctor:</strong> {{providerName}}
        </mj-text>
        {{/unless}}
        <mj-text padding="0">
          <strong>Reference:</strong> {{referenceId}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-text font-size="12px" color="#71717a" padding="0">
      Please arrive on time. Call our hotline {{hotline}} immediately if you need to make changes.
    </mj-text>
  </mj-column>
</mj-section>

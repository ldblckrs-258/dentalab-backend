<mj-section padding="0 24px">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    {{#if isUser}}
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Appointment cancelled
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Hello {{providerName}},<br />
      The appointment with patient {{patientName}} at {{clinicName}} has been cancelled.
    </mj-text>
    {{else}}
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Your appointment has been cancelled
    </mj-text>
    <mj-text color="#52525b" padding="0 0 20px">
      Hello {{patientName}},<br />
      Your appointment at {{clinicName}} has been cancelled.
    </mj-text>
    {{/if}}
    <mj-section padding="0 0 20px">
      <mj-column
        background-color="#f4f4f5"
        border-radius="12px"
        padding="20px"
      >
        <mj-text padding="0 0 8px">
          <strong>Service:</strong> {{serviceName}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Date:</strong> {{appointmentDate}}
        </mj-text>
        <mj-text padding="0 0 8px">
          <strong>Time:</strong> {{appointmentTime}}
        </mj-text>
        {{#if cancellationReason}}
        <mj-text padding="0 0 8px">
          <strong>Reason:</strong> {{cancellationReason}}
        </mj-text>
        {{/if}}
        <mj-text padding="0">
          <strong>Reference:</strong> {{referenceId}}
        </mj-text>
      </mj-column>
    </mj-section>
    {{#unless isUser}}
    <mj-text font-size="12px" color="#71717a" padding="0">
      If you wish to rebook, please call our hotline {{hotline}}.
    </mj-text>
    {{/unless}}
  </mj-column>
</mj-section>

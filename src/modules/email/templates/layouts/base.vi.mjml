<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="14px" color="#27272a" line-height="1.6" />
      <mj-button
        background-color="#6366f1"
        color="#ffffff"
        border-radius="999px"
        font-size="14px"
        font-weight="600"
        inner-padding="14px 28px"
      />
    </mj-attributes>
    <mj-style>
      .brand-name {
        color: #6366f1;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .panel {
        background: #ffffff;
        border: 1px solid #e4e4e7;
        border-radius: 16px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fafafa">
    <!-- Header -->
    <mj-section padding="28px 24px 20px">
      <mj-column vertical-align="middle">
        <mj-text align="center" font-size="22px" padding="0">
          <a
            href="{{loginLink}}"
            style="text-decoration: none; display: inline-block; line-height: 1"
          >
            <img
              src="{{logoUrl}}"
              alt="D"
              width="28"
              height="28"
              style="
                vertical-align: middle;
                border: 0;
                display: inline-block;
                margin-right: 6px;
                font-size: 14px;
              "
            />
            <span
              class="brand-name"
              style="vertical-align: middle; color: #6366f1; font-weight: 700"
              >DentaLab</span
            >
          </a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content (child template content injected here) -->
    {{{content}}}

    <!-- Footer -->
    <mj-section padding="8px 24px 24px">
      <mj-column>
        <mj-divider
          border-color="#e4e4e7"
          border-width="1px"
          padding="0 0 16px"
        />
        <mj-text align="center" font-size="11px" color="#71717a" padding="0">
          <a href="{{mapUrl}}" style="color: #71717a; text-decoration: none">{{
            practiceAddress
          }}</a>
        </mj-text>
        <mj-text
          align="center"
          font-size="11px"
          color="#71717a"
          padding="4px 0 0"
        >
          Hỗ trợ: {{#if isUser
          }}<a
            href="mailto:{{supportEmail}}"
            style="color: #6366f1; text-decoration: none"
            >{{ supportEmail }}</a
          >{{else
          }}<a
            href="mailto:{{customerServiceEmail}}"
            style="color: #6366f1; text-decoration: none"
            >{{ customerServiceEmail }}</a
          >{{/if}}
        </mj-text>
        <mj-text
          align="center"
          font-size="11px"
          color="#a1a1aa"
          padding="8px 0 0"
        >
          Đây là email tự động. Vui lòng không trả lời trực tiếp email này.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<!-- Welcome email content -->
<mj-section padding="0 24px" css-class="panel-wrap">
  <mj-column
    background-color="#ffffff"
    border="1px solid #e4e4e7"
    border-radius="16px"
    padding="32px 28px"
  >
    <mj-text font-size="22px" font-weight="700" color="#27272a" padding="0 0 8px">
      Welcome to DentaLab!
    </mj-text>
    <mj-text color="#52525b" padding="0 0 16px">
      Hello {{userName}},
    </mj-text>
    <mj-text padding="0">
      {{#if temporaryPassword}}
      <p style="margin:0 0 12px;color:#52525b;">Your account has been created. Here are your login credentials:</p>
      <div
        style="
          margin:0 0 12px;
          padding:16px 20px;
          background-color:#f4f4f5;
          border:1px solid #e4e4e7;
          border-radius:12px;
          font-size:14px;
          color:#27272a;
        "
      >
        <div style="margin-bottom:6px;"><strong style="color:#71717a;">Email:</strong> {{email}}</div>
        <div><strong style="color:#71717a;">Temporary password:</strong> <code style="background:#ffffff;padding:2px 8px;border-radius:6px;border:1px solid #e4e4e7;color:#6366f1;font-weight:600;">{{temporaryPassword}}</code></div>
      </div>
      <p style="margin:0;color:#71717a;font-size:13px;">For security reasons, please change this password immediately after your first login.</p>
      {{else}}
      <p style="margin:0;color:#52525b;">Your account has been created. You can log in using the email and password provided by the administrator.</p>
      {{/if}}
    </mj-text>
    <mj-button href="{{loginLink}}" padding="24px 0 0">
      Login now
    </mj-button>
  </mj-column>
</mj-section>

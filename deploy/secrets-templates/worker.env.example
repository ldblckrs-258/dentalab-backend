# -> /opt/dentalab/secrets/worker.env  (chmod 600)

# --- Database (asyncpg driver; internal port 5432) ---
DATABASE_URL=postgresql+asyncpg://dentalab:__STRONG_DB_PASSWORD__@postgres:5432/dentalab

# --- RabbitMQ (queue declared by backend) ---
RABBITMQ_URL=amqp://dentalab:__STRONG_RABBITMQ_PASSWORD__@rabbitmq:5672
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_QUEUE=rag.indexing

# --- Storage (R2; private bucket for documents) ---
S3_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dentalab-private
S3_ACCESS_KEY=__R2_ACCESS_KEY__
S3_SECRET_KEY=__R2_SECRET_KEY__

# --- Service auth (MUST match backend RAG_SERVICE_TOKEN) ---
RAG_SERVICE_TOKEN=__SHARED_RAG_TOKEN_MIN_16_CHARS__

# --- Service bind ---
RAG_HOST=0.0.0.0
RAG_PORT=8000

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=4
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512

# --- ONNX runtime (CPU) ---
ONNX_PROVIDER=cpu
ONNX_INTRA_THREADS=2
ONNX_INTER_THREADS=0
ONNX_EXECUTION_MODE=sequential
USE_QUANTIZED_MODELS=true

# --- HF cache (matches Dockerfile ENV + compose hf_cache volume) ---
HF_HOME=/app/.hf_cache
SENTENCE_TRANSFORMERS_HOME=/app/.hf_cache

# --- Chunking / search / cleanup (defaults) ---
CHILD_CHUNK_MIN_SIZE=400
CHILD_CHUNK_MAX_SIZE=600
SEARCH_TOP_K=5
SEARCH_MIN_SCORE=0.0
SEARCH_CONTEXT_MAX_CHARS=3000
FAILED_RETENTION_DAYS=7
STUCK_PROCESSING_SWEEP_MINUTES=10
STUCK_PROCESSING_THRESHOLD_MINUTES=10
LOG_LEVEL=INFO

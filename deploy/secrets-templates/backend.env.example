# -> /opt/dentalab/secrets/backend.env  (chmod 600)
# Generate secrets: openssl rand -base64 32

# --- App ---
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_NAME=DentaLab API
CORS_ORIGINS=https://app.dentalab.health.vn
FRONTEND_URL=https://app.dentalab.health.vn

# --- Database (host = compose service name, internal port 5432) ---
DATABASE_URL=postgresql://dentalab:__STRONG_DB_PASSWORD__@postgres:5432/dentalab?schema=public
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis (internal port 6379, NOT dev's 6380) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://dentalab:__STRONG_RABBITMQ_PASSWORD__@rabbitmq:5672
RABBITMQ_PREFETCH_COUNT=10

# --- Storage (Cloudflare R2; two buckets) ---
S3_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dentalab-private
S3_PUBLIC_BUCKET=dentalab-public
S3_ACCESS_KEY=__R2_ACCESS_KEY__
S3_SECRET_KEY=__R2_SECRET_KEY__
S3_PUBLIC_URL=https://cdn.dentalab.health.vn
S3_MAX_FILE_SIZE=52428800
S3_SSE_ENABLED=true

# --- JWT ---
JWT_SECRET=__OPENSSL_RAND_BASE64_32__
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Admin seed (MUST set strong; else seed defaults to Admin@123) ---
ADMIN_EMAIL=admin@dentalab.health.vn
ADMIN_PASSWORD=__STRONG_ADMIN_PASSWORD__

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@dentalab.health.vn
EMAIL_FROM_NAME=DentaLab
EMAIL_REPLY_TO=
# REQUIRED in prod: if unset, webhook signature verification is skipped entirely
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# --- AI / RAG ---
RAG_SERVICE_URL=http://worker:8000
RAG_SERVICE_TOKEN=__SHARED_RAG_TOKEN_MIN_16_CHARS__
AI_CONFIG_ENCRYPTION_KEY=__OPENSSL_RAND_BASE64_32__
LLM_ANSWER_TIMEOUT_MS=45000
LLM_REWRITE_TIMEOUT_MS=15000

# --- Audit (else uses a known dev-default key) ---
AUDIT_REDACTION_HMAC_KEY=__OPENSSL_RAND_BASE64_32__

# --- Public Booking ---
BOOKING_TICKET_SECRET=__OPENSSL_RAND_BASE64_32__
BOOKING_OTP_PEPPER=__OPENSSL_RAND_BASE64_32__
